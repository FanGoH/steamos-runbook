STEAMOS_NIC_INTERFACE=enp8s0
STEAMOS_USER=deck
STEAMOS_PLAYBOOK_DIR=/home/deck/steamos-playbook
STEAMOS_DISTROBOX_NAME=steamos-tools
STEAMOS_DISTROBOX_IMAGE=registry.fedoraproject.org/fedora:42

# Headscale / Tailscale (deck-tailscale install)
# Required for Tailscale re-login hints — set your Headscale URL here
TAILSCALE_LOGIN_SERVER=https://headscale.example.com
TAILSCALE_HOSTNAME=steamdeck
TAILSCALE_OPERATOR=deck
TAILSCALE_BIN=/opt/tailscale/tailscale

# Flatpak / services
OPENRGB_FLATPAK_ID=org.openrgb.OpenRGB
OPENRGB_UDEV_RULES=/etc/udev/rules.d/60-openrgb.rules
OPENRGB_PROFILE=ramoff
OPENRGB_SDK_HOST=127.0.0.1
OPENRGB_SDK_PORT=6742
SUNSHINE_USER_SERVICE=app-dev.lizardbyte.app.Sunshine.service
SUNSHINE_FLATPAK_ID=dev.lizardbyte.app.Sunshine
# Decky launches this same Flatpak. Do not enable the user unit.
SUNSHINE_GAMESTREAM_URL=http://127.0.0.1:47989
SUNSHINE_UI_URL=https://127.0.0.1:47990
SUNSHINE_STATE=/home/deck/.var/app/dev.lizardbyte.app.Sunshine/config/sunshine/sunshine_state.json
DECKY_SUNSHINE_SETTINGS=/home/deck/homebrew/settings/decky-sunshine/decky-sunshine.json
DECKY_LOADER_URL=http://127.0.0.1:1337
DECKY_SUNSHINE_PLUGIN_NAME=Decky Sunshine
# Pulse-ready start (not the Flatpak Sunshine unit, not a poll loop)
SUNSHINE_WATCH_PATH=steamos-sunshine-watch.path
SUNSHINE_WATCH_SERVICE=steamos-sunshine-watch.service

# AUR helper (optional; prefer Flatpaks on SteamOS tiny root)
AUR_HELPER=paru

# AppImage manager (Flatpak → /home)
GEARLEVER_FLATPAK_ID=it.mijorus.gearlever
FLATPAK_REMOTE=flathub

# Cursor Agent worker (My Machines; user systemd service)
# Personal login via `agent login` — do not put API keys here.
CURSOR_AGENT_BIN=/home/deck/.local/bin/agent
CURSOR_WORKER_SERVICE=cursor-agent-worker.service
# First --worker-dir is the assignment identity. Keep this playbook first so
# My Machines still matches FanGoH/steamos-runbook after reboot.
CURSOR_WORKER_DIR=/home/deck/steamos-playbook
# Extra workspace roots, space-separated (paths with spaces are not supported).
CURSOR_WORKER_EXTRA_DIRS=/home/deck/code
# Optional display name (defaults to hostname if empty)
CURSOR_WORKER_NAME=
CURSOR_WORKER_MGMT_ADDR=127.0.0.1:18789
# 0 = stay connected (needed for a long-lived systemd service)
CURSOR_WORKER_IDLE_RELEASE_TIMEOUT=0
# Separate from the Cursor app's default ~/.local/share/cursor-agent lock
CURSOR_WORKER_DATA_DIR=/home/deck/.local/share/cursor-agent-systemd

# Optional: in-sandbox Eden component (ensure-eden-component.sh)
# EDEN_APPIMAGE=/home/deck/AppImages/eden.appimage
# EDEN_COMPONENT_DIR=/home/deck/.var/app/net.retrodeck.retrodeck/data/retrodeck/external_components/eden
# EDEN_ES_CUSTOM_DIR=/home/deck/retrodeck/ES-DE/custom_systems
